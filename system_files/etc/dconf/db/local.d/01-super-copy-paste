[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/super-copy/','/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/super-paste/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/super-copy]
name='Super Copy'
command='/usr/local/bin/super-copy'
binding='<Super>c'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/super-paste]
name='Super Paste'
command='/usr/local/bin/super-paste'
binding='<Super>v'
