#!/bin/bash

set -euo pipefail

focused_app_id="$(
  gdbus call --session \
    --dest org.gnome.Shell \
    --object-path /org/gnome/Shell \
    --method org.gnome.Shell.Eval \
    "let app = imports.gi.Shell.WindowTracker.get_default().focus_app; app ? app.get_id() : ''" \
    2>/dev/null | sed -n "s/^.*'\\(.*\\)'\\).*$/\\1/p"
)"

case "${focused_app_id}" in
  org.gnome.Terminal.desktop|\
  org.wezfurlong.wezterm.desktop|\
  com.mitchellh.ghostty.desktop|\
  Alacritty.desktop|\
  kitty.desktop|\
  org.kde.konsole.desktop|\
  org.gnome.Console.desktop|\
  com.github.amezin.ddterm.desktop|\
  com.gexperts.Tilix.desktop)
    exec wtype -M ctrl -M shift v -m shift -m ctrl
    ;;
  *)
    exec wtype -M ctrl v -m ctrl
    ;;
esac
